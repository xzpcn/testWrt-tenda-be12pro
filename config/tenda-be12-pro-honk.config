# FanchmWrt-snapshot Tenda BE12 Pro + honk 专用配置
# 目标: mediatek/filogic/tenda_be12-pro (或 mediatek/mt7986, 视具体源码分支定义为准)
# 用法: 工作流会自动 cp 到 openwrt/.config 然后 make defconfig
# 本地验证: cp config/tenda-be12-pro-honk.config openwrt/.config && make defconfig
# 说明: dae/daed 已整体换成 honk (https://github.com/daeuniverse/honk),
#       包源改用官方 feed daeuniverse/openwrt-packages, 见 scripts/diy-part1.sh

# ===== Target =====
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_tenda_be12-pro=y

# 提示：如果是 hanwckf 等老源码分支，请取消下面两行的注释，并注释掉上面对应的两行：
# CONFIG_TARGET_mediatek_mt7986=y
# CONFIG_TARGET_mediatek_mt7986_DEVICE_tenda_be12-pro=y

# 仅编译这一个机型
CONFIG_TARGET_ALL_PROFILES=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# ===== 闪存分区大小限制 (针对 Tenda BE12 Pro 128MB SPI-NAND 优化) =====
# 物理 UBI 空间约 90MB，这里切回安全上限（85MB），防止插件积攒过多导致超出硬件物理总线限制
# honk 二进制约 15MB 上下 (含内嵌 doona 前端), 比 daed 全家桶小, 85MB 够用
CONFIG_TARGET_ROOTFS_PARTSIZE=85
CONFIG_TARGET_KERNEL_PARTSIZE=6

# ===== 内核 eBPF/BTF (honk 必需) =====
# honk 的 eBPF 由它自己的 Rust 工具链编好内嵌进二进制, 编译期不需要 bpf-headers,
# 但运行期必须有 BTF: 先读 /sys/kernel/btf/vmlinux, 读不到才退到 vmlinux-btf 的 blob
# 注意: KERNEL_DEBUG_INFO_REDUCED 默认 y, 会卡掉 BTF (depends on !REDUCED), 必须显式关掉
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_BPF_SYSCALL=y
CONFIG_KERNEL_BPF_JIT=y
CONFIG_KERNEL_CGROUPS=y
# honk 往根 cgroup 挂 socket-identity 和 TCP sock_ops, CGROUP_BPF 是硬性要求
CONFIG_KERNEL_CGROUP_BPF=y
# BPF_EVENTS 只有 native-api 的 UDP receive-trace 兜底才用得上, 要更小的内核可以关掉
CONFIG_KERNEL_BPF_EVENTS=y
# XDP_SOCKETS 是 daed 的需求, honk 用不到, 已移除 (能省下一些内核体积)
# honk 要求内核 >= 6.12 (compiled routing 要同步 map-in-map 发布), 本分支 mediatek 是 6.18
# TCX 后端要求 CONFIG_NET_XGRESS: 它是被 NET_CLS_ACT 选中的隐藏项, 无法在 .config 里手写,
# 只要下面勾了 kmod-sched-core / kmod-sched-bpf 就会自动打开

# ===== 开发者选项 + BPF 工具链 =====
# honk 本身不再走 bpf-headers, 这两行只是兜底: 万一还有别的包要编 eBPF,
# 让它用主机 clang (工作流已 apt 安装), 不去编一整套 LLVM
CONFIG_DEVEL=y
CONFIG_BPF_TOOLCHAIN_HOST=y

# ===== honk 主体 (官方 feed: daeuniverse/openwrt-packages) =====
CONFIG_PACKAGE_honk=y
CONFIG_PACKAGE_luci-app-honk=y
CONFIG_PACKAGE_luci-lib-daeuniverse=y
# 翻译挂在共享页 luci-lib-daeuniverse 上, 包名是 luci-i18n-daeuniverse-<lang>
CONFIG_PACKAGE_luci-i18n-daeuniverse-zh-cn=y
CONFIG_PACKAGE_luci-i18n-daeuniverse-zh-tw=y

# ===== BTF 二选一: 自编内核自带 BTF, 用空壳包顶替 blob 版 =====
# 满足 honk 的 +vmlinux-btf 依赖, 不装任何文件
CONFIG_PACKAGE_vmlinux-btf-builtin=y
# CONFIG_PACKAGE_vmlinux-btf is not set
# blob 版 vmlinux-btf 必须由 daeuniverse 的 SDK 流水线喂 VMLINUX_BTF_SRC 才有东西可装,
# 源码编译路径下保持关闭, 否则 make 会在它的 Build/Prepare 阶段直接报错
# 另外 blob 版锁死官方内核的 vermagic, 自编译内核根本装不上

# ===== honk 运行时依赖 (包 DEPENDS 已含, 显式列出便于核对与排查) =====
# libstdcpp 会顺带打开工具链的 C++ 支持, 首次编译要重编一遍 gcc, 多花十几分钟
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_nftables=y

# ===== 原有保留插件 (与 dae/daed 无关, 照旧) =====
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-app-temp-status=y
CONFIG_PACKAGE_luci-compat=y

# ===== 基础体验 (保留官方默认习惯) =====
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

# ===== 文件系统 / 工具 (128MB 闪存按需保留) =====
# 如果不接外部 USB 存储，可以不勾选以下几项以进一步节约 1-2MB 空间
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_usbutils=y
